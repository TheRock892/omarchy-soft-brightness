{
  "schemaVersion": 1,
  "id": "io.github.therock892.soft-brightness",
  "name": "Soft Brightness",
  "version": "1.0.0",
  "author": "luigi",
  "license": "MIT",
  "homepage": "https://github.com/TheRock892/omarchy-soft-brightness",
  "repository": "https://github.com/TheRock892/omarchy-soft-brightness",
  "description": "Virtual brightness for an external monitor whose real DDC/CI brightness control does not work, via a per-monitor dimming overlay",
  "keywords": [
    "brightness",
    "monitor",
    "external",
    "dim",
    "ddc"
  ],
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "Panel.qml"
  },
  "barWidget": {
    "displayName": "Soft Brightness",
    "description": "Dims an external monitor that has no working hardware brightness control, via a click-through overlay",
    "category": "System",
    "aliases": [
      "brightness",
      "monitor",
      "external",
      "dim",
      "ddc"
    ],
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "monitor": "",
      "refreshIntervalSec": 5
    },
    "schema": [
      {
        "key": "monitor",
        "type": "string",
        "label": "Monitor name (empty = auto-detect external)",
        "defaultValue": ""
      },
      {
        "key": "refreshIntervalSec",
        "type": "integer",
        "label": "Refresh interval while open (seconds)",
        "min": 2,
        "max": 30,
        "step": 1,
        "defaultValue": 5
      }
    ]
  }
}
